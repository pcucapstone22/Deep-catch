import os
import torch
import torch.nn as nn
from torchvision import models, transforms
from torch.utils.data import Dataset, DataLoader
from PIL import Image
import numpy as np
import scipy.fftpack  # 2D 이산 코사인 변환(DCT) 연산을 위한 SciPy 모듈 (setup_env.py에 'scipy' 추가 권장)

# ==============================================================================
# [1] 딥페이크 탐지 모델 아키텍처 정의부 (3종 모델)
# ==============================================================================

class SpatialCNNDetector(nn.Module):
    """
    [모델 1] 공간 영역(Spatial Domain) 전용 탐지 모델
    - 입력: 원본 RGB 컬러 이미지 텐서 [Batch, 3, 256, 256]
    - 역할: 피부 질감의 부자연스러움, 얼굴 윤곽선 경계 왜곡, 조명 불일치 등 
            사람의 눈이나 픽셀 단위로 드러나는 시각적 합성 흔적을 추출합니다.
    """
    def __init__(self, num_classes=2):
        super(SpatialCNNDetector, self).__init__()
        
        # ImageNet으로 사전 학습된 EfficientNet-B0 백본 로드 (가볍고 특징 추출 성능이 뛰어남)
        self.backbone = models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)
        
        # 기존 EfficientNet 마지막 분류기(Linear)의 입력 특징 차원 수 추출 (기본값: 1280차원)
        self.out_features = self.backbone.classifier[1].in_features
        
        # 기존 1000개 클래스 분류 헤드를 제거(Identity로 대체)하여 순수 특징 벡터(1280D)만 출력하도록 개조
        self.backbone.classifier = nn.Identity()
        
        # 딥페이크 이진 분류(Real vs Fake)를 위한 커스텀 분류 헤드 구성
        self.classifier = nn.Sequential(
            nn.Dropout(0.3),  # 과적합(Overfitting) 방지를 위해 학습 시 30% 뉴런 무작위 비활성화
            nn.Linear(self.out_features, num_classes)  # 1280차원 특징 -> 2개 클래스 로짓(Logit) 출력
        )

    def forward(self, rgb_image):
        # rgb_image: [Batch, 3, 256, 256] -> features: [Batch, 1280]
        features = self.backbone(rgb_image)
        # features: [Batch, 1280] -> output: [Batch, 2]
        output = self.classifier(features)
        return output


class FrequencyNoiseDetector(nn.Module):
    """
    [모델 2] 주파수 영역(Frequency Domain) 전용 탐지 모델
    - 입력: 2D DCT 변환된 1채널 주파수 스펙트럼 맵 [Batch, 1, 256, 256]
    - 역할: GAN이나 Diffusion 모델이 이미지를 생성/업샘플링(Upsampling)할 때 남기는
            특유의 고주파 격자(Checkerboard) 아티팩트 및 미세 노이즈 패턴을 포착합니다.
    """
    def __init__(self, in_channels=1, num_classes=2):
        super(FrequencyNoiseDetector, self).__init__()
        
        # 4단계 합성곱(Conv2d) 블록으로 구성된 경량 CNN 아키텍처
        # 공간 해상도를 절반씩 줄여가며(256 -> 128 -> 64 -> 32) 채널 깊이를 확장(1 -> 64 -> 128 -> 256 -> 512)
        self.lightweight_cnn = nn.Sequential(
            # Block 1: [Batch, 1, 256, 256] -> [Batch, 64, 128, 128]
            nn.Conv2d(in_channels, 64, kernel_size=3, stride=1, padding=1, bias=False),
            nn.BatchNorm2d(64),  # 배치 정규화로 학습 안정화
            nn.ReLU(),           # 비선형 활성화 함수
            nn.MaxPool2d(2, 2),  # 공간 크기 1/2 축소
            
            # Block 2: [Batch, 64, 128, 128] -> [Batch, 128, 64, 64]
            nn.Conv2d(64, 128, kernel_size=3, stride=1, padding=1, bias=False),
            nn.BatchNorm2d(128),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            # Block 3: [Batch, 128, 64, 64] -> [Batch, 256, 32, 32]
            nn.Conv2d(128, 256, kernel_size=3, stride=1, padding=1, bias=False),
            nn.BatchNorm2d(256),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            # Block 4: [Batch, 256, 32, 32] -> [Batch, 512, 1, 1]
            nn.Conv2d(256, 512, kernel_size=3, stride=1, padding=1, bias=False),
            nn.BatchNorm2d(512),
            nn.ReLU(),
            nn.AdaptiveAvgPool2d((1, 1)),  # 입력 해상도에 관계없이 각 채널의 평균값을 뽑아 [Batch, 512, 1, 1]로 압축
            nn.Flatten()                    # 1차원 벡터로 평탄화 -> [Batch, 512]
        )
        
        self.classifier = nn.Sequential(
            nn.Dropout(0.3),
            nn.Linear(512, num_classes)     # 512차원 주파수 특징 -> 2개 클래스 로짓 출력
        )

    def forward(self, freq_image):
        # freq_image: [Batch, 1, 256, 256] -> features: [Batch, 512]
        features = self.lightweight_cnn(freq_image)
        # output: [Batch, 2]
        output = self.classifier(features)
        return output


class DualStreamDeepfakeDetector(nn.Module):
    """
    [모델 3] 공간 + 주파수 하이브리드 듀얼 스트림(Dual-Stream) 결합 탐지 모델
    - 입력: RGB 이미지([Batch, 3, 256, 256])와 DCT 주파수 맵([Batch, 1, 256, 256])을 동시 입력
    - 역할: 두 도메인에서 추출한 고차원 특징 벡터를 하나로 융합(Feature-level Fusion)하여
            단일 모델이 놓칠 수 있는 교묘한 변조 흔적까지 종합적으로 판별합니다.
    """
    def __init__(self, num_classes=2):
        super(DualStreamDeepfakeDetector, self).__init__()
        
        # [Stream A] 공간 영역 특징 추출기 (EfficientNet-B0 -> 1280차원 출력)
        self.spatial_stream = models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)
        in_features_eff = self.spatial_stream.classifier[1].in_features
        self.spatial_stream.classifier = nn.Identity()

        # [Stream B] 주파수 영역 특징 추출기 (ResNet-18 -> 512차원 출력)
        self.freq_stream = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)
        # 기본 ResNet-18의 첫 번째 레이어(conv1)는 3채널(RGB) 입력용이므로, 
        # 1채널 DCT 주파수 맵을 받을 수 있도록 in_channels=1로 커스터마이징
        self.freq_stream.conv1 = nn.Conv2d(1, 64, kernel_size=7, stride=2, padding=3, bias=False)
        in_features_res = self.freq_stream.fc.in_features
        self.freq_stream.fc = nn.Identity()

        # 결합된 특징 벡터의 총 차원 수 계산 (1280 + 512 = 1792차원)
        fusion_dim = in_features_eff + in_features_res

        # 융합된 1792차원 특징을 처리하는 심층 분류기(MLP)
        self.classifier = nn.Sequential(
            nn.Linear(fusion_dim, 512),  # 1792차원 -> 512차원으로 핵심 정보 압축
            nn.BatchNorm1d(512),         # 1차원 특징 벡터 정규화
            nn.ReLU(),
            nn.Dropout(0.4),             # 듀얼 스트림의 높은 표현력으로 인한 과적합 방지를 위해 드롭아웃 상향(40%)
            nn.Linear(512, num_classes)  # 최종 2개 클래스(Real/Fake) 로짓 출력
        )

    def forward(self, rgb_image, dct_image):
        # 1. 각 스트림에서 독립적으로 특징 추출
        spatial_features = self.spatial_stream(rgb_image)  # [Batch, 1280]
        freq_features = self.freq_stream(dct_image)        # [Batch, 512]
        
        # 2. 채널(dim=1) 방향으로 두 특징 벡터를 이어 붙임(Concatenation)
        fused_features = torch.cat((spatial_features, freq_features), dim=1)  # [Batch, 1792]
        
        # 3. 융합된 특징을 분류기에 통과시켜 최종 예측값 도출
        output = self.classifier(fused_features)  # [Batch, 2]
        return output


# ==============================================================================
# [2] 듀얼 스트림 전용 PyTorch Custom Dataset 클래스
# ==============================================================================
class DualStreamDataset(Dataset):
    """
    압축 해제된 데이터셋 디렉토리(./extracted_data/real, ./extracted_data/fake)를 탐색하여
    학습 및 추론에 필요한 (RGB 텐서, DCT 주파수 텐서, 정답 라벨) 튜플을 실시간 생성합니다.
    """
    def __init__(self, data_dir, transform=None):
        self.data_dir = data_dir
        self.transform = transform
        self.image_paths = []
        self.labels = []
        
        # 폴더명과 정답 라벨 인덱스 매핑 (Real: 0, Fake: 1)
        class_mapping = {'real': 0, 'fake': 1}
        
        for label_name, label_idx in class_mapping.items():
            class_folder = os.path.join(data_dir, label_name)
            if os.path.exists(class_folder):
                for img_name in os.listdir(class_folder):
                    # 지원하는 이미지 확장자만 필터링하여 리스트에 경로와 라벨 적재
                    if img_name.lower().endswith(('png', 'jpg', 'jpeg', 'bmp', 'webp')):
                        self.image_paths.append(os.path.join(class_folder, img_name))
                        self.labels.append(label_idx)

    def __len__(self):
        # 전체 데이터셋의 총 이미지 개수 반환
        return len(self.image_paths)

    def _get_dct_map(self, img_pil):
        """
        PIL 이미지를 받아 2D DCT(이산 코사인 변환) 주파수 맵 텐서로 변환하는 내부 헬퍼 함수
        """
        # 1. 색상 정보를 제거한 흑백('L') 변환 후 256x256 고정 해상도로 리사이즈
        img_gray = img_pil.convert('L').resize((256, 256))
        img_np = np.float32(img_gray)
        
        # 2. 행(axis=0)과 열(axis=1) 방향으로 직교 정규화(norm='ortho')된 2D DCT 수행
        #    -> 좌상단에는 저주파(전체 윤곽), 우하단에는 고주파(미세 질감/노이즈) 성분이 집중됨
        dct_np = scipy.fftpack.dct(
            scipy.fftpack.dct(img_np, axis=0, norm='ortho'), 
            axis=1, norm='ortho'
        )
        
        # 3. 주파수 계수는 저주파 영역의 값이 극단적으로 크고 고주파는 매우 작으므로,
        #    절댓값에 로그(log) 스케일링을 적용해 고주파 영역의 미세 패턴이 잘 드러나도록 스케일 압축
        #    (+ 1e-5는 log(0)으로 인한 -inf 연산 오류 방지용 엡실론 값)
        dct_log = np.log(np.abs(dct_np) + 1e-5)
        
        # 4. PyTorch CNN 입력 규격인 [Channel=1, Height=256, Width=256] 형태로 차원 확장
        dct_tensor = torch.tensor(dct_log, dtype=torch.float32).unsqueeze(0)
        return dct_tensor

    def __getitem__(self, idx):
        img_path = self.image_paths[idx]
        label = self.labels[idx]
        
        # 손상된 이미지 파일로 인해 전체 학습 루프가 중단되는 것을 방지하기 위한 예외 처리
        try:
            img_pil = Image.open(img_path).convert('RGB')
        except Exception as e:
            print(f"[경고] 이미지 로드 실패 ({img_path}): {e}")
            img_pil = Image.new('RGB', (256, 256))  # 검은색 더미 이미지로 대체

        # [Stream 1 데이터] 공간 영역 RGB 텐서 생성
        if self.transform:
            rgb_tensor = self.transform(img_pil)
        else:
            # 별도 transform이 지정되지 않은 경우 ImageNet 표준 평균/표준편차로 정규화 수행
            basic_transform = transforms.Compose([
                transforms.Resize((256, 256)),
                transforms.ToTensor(),
                transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
            ])
            rgb_tensor = basic_transform(img_pil)

        # [Stream 2 데이터] 주파수 영역 2D DCT 텐서 생성
        dct_tensor = self._get_dct_map(img_pil)

        return rgb_tensor, dct_tensor, torch.tensor(label, dtype=torch.long)


# ==============================================================================
# [3] 아키텍처 입출력 차원(Shape) 검증용 단독 실행 테스트
# ==============================================================================
if __name__ == "__main__":
    print("=== 듀얼 스트림 모델 및 데이터셋 로드 테스트 ===")
    
    # GPU(CUDA) 사용 가능 여부 자동 감지
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    
    # 모델 생성 및 연산 장치(GPU/CPU) 할당
    model = DualStreamDeepfakeDetector(num_classes=2).to(device)
    print(f"모델이 성공적으로 {device}에 로드되었습니다.")

    # 가상의 배치(Batch Size = 2) 입력 텐서 생성 후 순전파(Forward) 차원 검증
    dummy_rgb = torch.randn(2, 3, 256, 256).to(device)  # [배치 2, RGB 3채널, 256, 256]
    dummy_dct = torch.randn(2, 1, 256, 256).to(device)  # [배치 2, DCT 1채널, 256, 256]
    
    output = model(dummy_rgb, dummy_dct)
    print(f"출력 로짓(Logits) Shape: {output.shape}")  # 기대값: torch.Size([2, 2]) -> 각 이미지별 [Real 점수, Fake 점수]
